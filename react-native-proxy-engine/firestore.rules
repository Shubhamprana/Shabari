rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isAuthenticated() && 
        request.auth.token.admin == true;
    }
    
    function isDeviceOwner(deviceId) {
      return isAuthenticated() && 
        request.auth.uid == deviceId;
    }
    
    function hasValidReportData() {
      return request.resource.data.keys().hasAll(['target', 'type', 'action', 'device_id', 'timestamp']) &&
        request.resource.data.type in ['domain', 'phone', 'ip', 'app'] &&
        request.resource.data.action in ['blocked', 'warned', 'monitored'] &&
        request.resource.data.timestamp is number;
    }
    
    function isRateLimited() {
      // Check if user has made less than 100 reports in last hour
      return true; // Implement rate limiting logic
    }
    
    // Fraud domains collection - read-only for users
    match /fraud_domains/{domain} {
      allow read: if true; // Public read for threat checking
      allow write: if isAdmin(); // Only admins can write
    }
    
    // Fraud numbers collection - read-only for users
    match /fraud_numbers/{number} {
      allow read: if true; // Public read for threat checking
      allow write: if isAdmin(); // Only admins can write
    }
    
    // Fraud IPs collection - read-only for users
    match /fraud_ips/{ip} {
      allow read: if true; // Public read for threat checking
      allow write: if isAdmin(); // Only admins can write
    }
    
    // Reports collection - users can create, admins can read/update
    match /reports/{reportId} {
      allow create: if isAuthenticated() && 
        hasValidReportData() && 
        isRateLimited() &&
        request.resource.data.device_id == request.auth.uid;
      
      allow read: if isAdmin() || 
        (isAuthenticated() && resource.data.device_id == request.auth.uid);
      
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // Filter rules collection - read-only for all
    match /filter_rules/{ruleId} {
      allow read: if true; // Public read for filter synchronization
      allow write: if isAdmin(); // Only admins can write
    }
    
    // Admin notifications - admins only
    match /admin_notifications/{notificationId} {
      allow read: if isAdmin();
      allow write: if false; // Only cloud functions can write
      allow update: if isAdmin() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
    
    // Audit logs - admins read only
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // Only cloud functions can write
    }
    
    // Daily reports - admins only
    match /daily_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false; // Only cloud functions can write
    }
    
    // User settings - users can read/write their own
    match /user_settings/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if isAuthenticated() && 
        request.auth.uid == userId &&
        request.resource.data.keys().hasAll(['notifications_enabled', 'auto_block_enabled']);
    }
    
    // Device registrations - for tracking unique devices
    match /devices/{deviceId} {
      allow read: if isDeviceOwner(deviceId);
      allow create: if isAuthenticated() && 
        request.auth.uid == deviceId &&
        request.resource.data.keys().hasAll(['platform', 'app_version', 'created_at']);
      allow update: if isDeviceOwner(deviceId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['last_active', 'app_version']);
    }
    
    // Statistics collection - read-only
    match /statistics/{statId} {
      allow read: if true; // Public statistics
      allow write: if false; // Only cloud functions can write
    }
  }
}
