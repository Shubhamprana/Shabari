# Firebase Configuration for Shabari Proxy Engine
# Copy this file to .env and fill in your Firebase project details

# Firebase Project Configuration
FIREBASE_API_KEY=your_api_key_here
FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id

# Firebase Admin SDK (for server-side functions)
FIREBASE_ADMIN_PROJECT_ID=your_project_id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your_project_id.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Admin Panel Configuration
ADMIN_EMAIL=admin@shabari.com
ADMIN_PASSWORD=your_secure_password

# Security Configuration
ENCRYPTION_SALT=shabari_salt_2024
JWT_SECRET=your_jwt_secret_key

# Database Configuration
DB_ENCRYPTION_KEY=your_database_encryption_key

# Notification Configuration
FCM_SERVER_KEY=your_fcm_server_key
ADMIN_NOTIFICATION_EMAIL=admin@shabari.com

# Development/Production Environment
NODE_ENV=development
DEBUG_MODE=true

# Rate Limiting
MAX_REPORTS_PER_HOUR=100
MAX_REPORTS_PER_DAY=1000

# Threat Detection Thresholds
THREAT_BLOCK_THRESHOLD=80
THREAT_WARN_THRESHOLD=50
THREAT_MONITOR_THRESHOLD=30

# DNS Configuration
PRIMARY_DNS=8.8.8.8
SECONDARY_DNS=8.8.4.4
LOCAL_DNS_PORT=5353

# VPN Configuration
VPN_SERVICE_NAME=ShabariProtection
VPN_NOTIFICATION_TITLE=Shabari Protection Active
VPN_NOTIFICATION_TEXT=Your device is protected from threats
